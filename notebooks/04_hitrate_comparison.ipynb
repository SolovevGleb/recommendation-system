   "source": [
    "# Оценка качества рекомендаций: HitRate@5\n",
    "\n",
    "Для оценки качества рекомендательной системы была реализована offline-метрика **HitRate@5**.\n",
    "\n",
    "Оценка выполнялась на тестовой выборке на уровне пользователей:\n",
    "\n",
    "1. Для каждого пользователя из тестовой выборки формировался набор кандидатов — посты, для которых необходимо предсказать вероятность взаимодействия.\n",
    "\n",
    "2. Для каждой пары **пользователь–пост** рассчитывались признаки.\n",
    "\n",
    "3. Обученная модель предсказывала вероятность положительного взаимодействия:\n",
    "\n",
    "```\n",
    "P(user взаимодействует с post)\n",
    "```\n",
    "\n",
    "4. Посты сортировались по полученной вероятности, после чего выбирались **5 наиболее релевантных рекомендаций (Top-5)**.\n",
    "\n",
    "Пример:\n",
    "\n",
    "```\n",
    "Рекомендации модели:\n",
    "[post_123, post_456, post_789, post_321, post_654]\n",
    "```\n",
    "\n",
    "5. Полученный список рекомендаций сравнивался с реальными положительными взаимодействиями пользователя в тестовой выборке.\n",
    "\n",
    "Если хотя бы один пост из Top-5 совпадал с постами, с которыми пользователь действительно взаимодействовал, считалось успешное попадание:\n",
    "\n",
    "```\n",
    "Hit@5 = 1\n",
    "```\n",
    "\n",
    "Если совпадений не было:\n",
    "\n",
    "```\n",
    "Hit@5 = 0\n",
    "```\n",
    "\n",
    "6. Итоговый показатель рассчитывался как среднее значение по всем пользователям.\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b0754d12-9f59-4aa9-a4c1-705c21c737e0",
   "metadata": {},
   "source": [
    "## Функция для оценки HitRate@K\n",
    "\n",
    "Функция `evaluate_hitrate()` предназначена для оценки качества рекомендательной модели по метрике **HitRate@K**.\n",
    "\n",
    "Она формирует тестовую выборку по времени, объединяет признаки пользователей, постов и взаимодействий, получает предсказания модели, строит Top-K рекомендаций для каждого пользователя и рассчитывает долю случаев, когда релевантный пост попал в список рекомендаций.\n",
    "\n",
    "Функция позволяет сравнивать качество разных рекомендательных моделей на одной методологии оценки."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "df6e3818-8851-48d2-942a-a860c7059e62",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "\n",
    "def evaluate_hitrate(\n",
    "        model,\n",
    "        post_path=r\"../data/features/post_text_dfNEW.csv\",\n",
    "        user_path=r\"../data/features/user_dataNEW.csv\",\n",
    "        feed_path=r\"../data/raw/feed_data.csv\",\n",
    "        k=5\n",
    "):\n",
    "    \"\"\"\n",
    "    Расчет HitRate@K для рекомендательной модели.\n",
    "\n",
    "    Parameters:\n",
    "    ----------\n",
    "    model : trained model\n",
    "        Обученная модель с методом predict_proba()\n",
    "\n",
    "    post_path : str\n",
    "        Путь к признакам постов\n",
    "\n",
    "    user_path : str\n",
    "        Путь к признакам пользователей\n",
    "\n",
    "    feed_path : str\n",
    "        Путь к данным взаимодействий\n",
    "\n",
    "    k : int\n",
    "        Размер top-k рекомендаций\n",
    "\n",
    "    \"\"\"\n",
    "\n",
    "\n",
    "    hit = []\n",
    "\n",
    "\n",
    "    # ======================\n",
    "    # Загрузка данных\n",
    "    # ======================\n",
    "\n",
    "    postnew = pd.read_csv(post_path)\n",
    "\n",
    "    usernew = pd.read_csv(user_path)\n",
    "\n",
    "    feed_data = pd.read_csv(feed_path)\n",
    "\n",
    "\n",
    "    # ======================\n",
    "    # Time split\n",
    "    # ======================\n",
    "\n",
    "    feed_data = feed_data.sort_values(\n",
    "        \"timestamp\"\n",
    "    )\n",
    "\n",
    "    n_total = len(feed_data)\n",
    "\n",
    "    n_test = int(n_total * 0.3)\n",
    "\n",
    "    n_train = n_total - n_test\n",
    "\n",
    "\n",
    "    train = feed_data.iloc[:n_train].reset_index(drop=True)\n",
    "\n",
    "    test = feed_data.iloc[n_train:].reset_index(drop=True)\n",
    "\n",
    "\n",
    "\n",
    "    # пользователи в тесте\n",
    "\n",
    "    user_test = (\n",
    "        test[[\"post_id\", \"user_id\"]]\n",
    "        .drop_duplicates()[\"user_id\"]\n",
    "        .unique()\n",
    "    )\n",
    "\n",
    "\n",
    "    # ======================\n",
    "    # Расчет HitRate\n",
    "    # ======================\n",
    "\n",
    "    for i, user in enumerate(user_test):\n",
    "\n",
    "\n",
    "        # признаки пользователя\n",
    "\n",
    "        user1 = usernew[\n",
    "            usernew[\"user_id\"] == user\n",
    "        ]\n",
    "\n",
    "\n",
    "        # посты пользователя в тесте\n",
    "\n",
    "        df_result = test[\n",
    "            test[\"user_id\"] == user\n",
    "        ][\n",
    "            [\n",
    "                \"timestamp\",\n",
    "                \"user_id\",\n",
    "                \"post_id\"\n",
    "            ]\n",
    "        ].copy()\n",
    "\n",
    "\n",
    "        df_result[\"timestamp\"] = pd.to_datetime(\n",
    "            df_result[\"timestamp\"]\n",
    "        )\n",
    "\n",
    "\n",
    "        # временные признаки\n",
    "\n",
    "        df_result[\"hour\"] = (\n",
    "            df_result[\"timestamp\"].dt.hour\n",
    "        )\n",
    "\n",
    "        df_result[\"week\"] = (\n",
    "            df_result[\"timestamp\"].dt.dayofweek\n",
    "        )\n",
    "\n",
    "        df_result[\"month\"] = (\n",
    "            df_result[\"timestamp\"].dt.month\n",
    "        )\n",
    "\n",
    "\n",
    "        df_result[\"hour_sin\"] = np.sin(\n",
    "            2 * np.pi * df_result[\"hour\"] / 24\n",
    "        )\n",
    "\n",
    "        df_result[\"hour_cos\"] = np.cos(\n",
    "            2 * np.pi * df_result[\"hour\"] / 24\n",
    "        )\n",
    "\n",
    "\n",
    "        df_result[\"month_sin\"] = np.sin(\n",
    "            2 * np.pi * df_result[\"month\"] / 12\n",
    "        )\n",
    "\n",
    "        df_result[\"month_cos\"] = np.cos(\n",
    "            2 * np.pi * df_result[\"month\"] / 12\n",
    "        )\n",
    "\n",
    "\n",
    "        df_result[\"week_sin\"] = np.sin(\n",
    "            2 * np.pi * df_result[\"week\"] / 7\n",
    "        )\n",
    "\n",
    "        df_result[\"week_cos\"] = np.cos(\n",
    "            2 * np.pi * df_result[\"week\"] / 7\n",
    "        )\n",
    "\n",
    "\n",
    "        df_result = df_result[\n",
    "            [\n",
    "                \"hour_sin\",\n",
    "                \"hour_cos\",\n",
    "                \"month_sin\",\n",
    "                \"month_cos\",\n",
    "                \"week_sin\",\n",
    "                \"week_cos\",\n",
    "                \"user_id\",\n",
    "                \"post_id\"\n",
    "            ]\n",
    "        ]\n",
    "\n",
    "\n",
    "        ids = df_result[\n",
    "            [\n",
    "                \"user_id\",\n",
    "                \"post_id\"\n",
    "            ]\n",
    "        ].copy()\n",
    "\n",
    "\n",
    "        # повторяем user features\n",
    "\n",
    "        df_one_repeated = pd.concat(\n",
    "            [user1] * len(df_result),\n",
    "            ignore_index=True\n",
    "        )\n",
    "\n",
    "\n",
    "        X = pd.concat(\n",
    "            [\n",
    "                df_one_repeated.reset_index(drop=True),\n",
    "                df_result.reset_index(drop=True)\n",
    "            ],\n",
    "            axis=1\n",
    "        )\n",
    "\n",
    "\n",
    "        # признаки постов\n",
    "\n",
    "        X = X.merge(\n",
    "            postnew,\n",
    "            on=\"post_id\",\n",
    "            how=\"left\"\n",
    "        )\n",
    "\n",
    "\n",
    "        # признаки модели\n",
    "\n",
    "\n",
    "        \n",
    "        if hasattr(model, \"feature_names_\"):\n",
    "            X = X[model.feature_names_]\n",
    "\n",
    "        elif hasattr(model, \"feature_name_\"):\n",
    "            X = X[model.feature_name_]\n",
    "\n",
    "        elif hasattr(model, \"feature_names_in_\"):\n",
    "            X = X[model.feature_names_in_]\n",
    "        # вероятность взаимодействия\n",
    "\n",
    "        ids[\"score\"] = (\n",
    "            model.predict_proba(X)[:, 1]\n",
    "        )\n",
    "\n",
    "\n",
    "        # Top-K рекомендаций\n",
    "\n",
    "        recommendations = (\n",
    "            ids\n",
    "            .sort_values(\n",
    "                \"score\",\n",
    "                ascending=False\n",
    "            )\n",
    "            [\"post_id\"]\n",
    "            .drop_duplicates()\n",
    "            .head(k)\n",
    "        )\n",
    "\n",
    "\n",
    "        # реальные положительные посты\n",
    "\n",
    "        true_posts = test[\n",
    "            (test[\"user_id\"] == user)\n",
    "            &\n",
    "            (test[\"target\"] != 0)\n",
    "        ][\"post_id\"]\n",
    "\n",
    "\n",
    "        hit.append(\n",
    "            int(\n",
    "                true_posts\n",
    "                .isin(recommendations)\n",
    "                .any()\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "        if (i + 1) % 2000 == 0:\n",
    "            print(\n",
    "                f\"Users: {i+1}, \"\n",
    "                f\"HitRate@{k}: {np.mean(hit):.4f}\"\n",
    "            )\n",
    "    \n",
    "\n",
    "\n",
    "    return np.mean(hit)"
   ]
  },
