    "### RecMLP\n",
    "\n",
    "Архитектура нейронной сети для рекомендательной системы.\n",
    "\n",
    "Используется для восстановления обученной модели из сохраненных весов (`modelNN.pth`). После загрузки модель переводится в режим инференса и передается в `NNWrapper`, который адаптирует её под общий интерфейс оценки качества (`predict_proba`) для расчета HitRate@K."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "850501e7-de83-4d20-8e65-89ce4912af16",
   "metadata": {},
   "outputs": [],
   "source": [
    "class RecMLP(nn.Module):\n",
    "    def __init__(self, input_dim):\n",
    "        super().__init__()\n",
    "\n",
    "        self.net = nn.Sequential(\n",
    "            nn.Linear(input_dim, 512),\n",
    "            nn.BatchNorm1d(512),\n",
    "            nn.ReLU(),\n",
    "            nn.Dropout(0.3),\n",
    "\n",
    "            nn.Linear(512, 256),\n",
    "            nn.BatchNorm1d(256),\n",
    "            nn.ReLU(),\n",
    "            nn.Dropout(0.3),\n",
    "\n",
    "            nn.Linear(256, 128),\n",
    "            nn.ReLU(),\n",
    "            nn.Dropout(0.2),\n",
    "\n",
    "            nn.Linear(128, 1)\n",
    "        )\n",
    "\n",
    "    def forward(self, x):\n",
    "        return self.net(x).squeeze(-1)"
   ]
  },
